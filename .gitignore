# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# backend dependencies
/backend/node_modules
/backend/.env
/backend/.env.local
/backend/.env.development.local
/backend/.env.test.local
/backend/.env.production.local

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
# GitHub Actionsが毎回ビルドしてデプロイするため、コミット不要
# （以前はここにビルド成果物を都度コミットしていたが、Slack Webhook URL等の
#   REACT_APP_*値がJSにそのまま埋め込まれ、GitHubのシークレット保護に
#   ブロックされる問題があった）
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
/.vscode
/.idea

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log 
# Firestoreクリーンアップのバックアップ（顧客名を含むためローカル保管のみ・コミット禁止）
scripts/backup-*.json
